POSTGRES_PASSWORD=change-me-to-a-long-random-string
DASHBOARD_PASSWORD=choose-a-password-for-the-monitor-page
DOMAIN=

# Daily push of contacts → SingleQR leads (HTTPS required). Prefer env over config.json.
# SINGLEQR_LEADS_URL=https://api.singleqr.in/api/v1/admin/leads/import-scraped
# SINGLEQR_LEADS_API_KEY=same-value-as-backend-LEADS_IMPORT_API_KEY
# SYNC_BOTH_STORES_ONLY=false
# false = push every contact with an email (Play-only / iOS-only / both). true = both-stores only.
